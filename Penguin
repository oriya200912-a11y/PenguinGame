import java.awt.*;

public class Penguin {

    private int x;
    private int y;
    private Color color;

    private final int SIZE = 40;
    private final int SPEED = 5;

    public Penguin(int x, int y, Color color) {
        this.x = x;
        this.y = y;
        this.color = color;
    }

    public void moveUp() {
        y -= SPEED;
    }

    public void moveDown() {
        y += SPEED;
    }

    public void moveLeft() {
        x -= SPEED;
    }

    public void moveRight() {
        x += SPEED;
    }

    public void draw(Graphics g) {

        g.setColor(color);

        g.fillOval(
                x,
                y,
                SIZE,
                SIZE
        );
    }
}
