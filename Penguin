import java.awt.*;
import javax.swing.*;

public class Penguin {

    private int x;
    private int y;

    private final int SIZE = 40;
    private final int SPEED = 2;

    private Image image;

    public Penguin(int x, int y, String imagePath) {
        this.x = x;
        this.y = y;

        ImageIcon icon = new ImageIcon(imagePath);
        image = icon.getImage();
    }

    public int getX() {
        return x;
    }

    public int getY() {
        return y;
    }

    public int getSize() {
        return SIZE;
    }

    public int getSpeed() {
        return SPEED;
    }

    public void setPosition(int x, int y) {
        this.x = x;
        this.y = y;
    }

    public void draw(Graphics g) {
        g.drawImage(
                image,
                x,
                y,
                SIZE,
                SIZE,
                null
        );
    }
    public int getCenterX() {
        return x + SIZE / 2;
    }
    
    public int getCenterY() {
        return y + SIZE / 2;
    }
}
