import java.awt.*;

public class Penguin {

    private int row;
    private int col;
    private Color color;

    public Penguin(int row, int col, Color color) {
        this.row = row;
        this.col = col;
        this.color = color;
    }

    public void draw(Graphics g, int tileSize, int offsetX, int offsetY) {

        int x = col * tileSize + offsetX;
        int y = row * tileSize + offsetY;

        g.setColor(color);

        g.fillOval(
                x + 10,
                y + 10,
                tileSize - 20,
                tileSize - 20
        );
    }
}
