import java.awt.*;
import javax.swing.*;

public class Penguin {

    private int x;
    private int y;
    private int currentRow = -1;
    private int currentCol = -1;

    private final int SIZE = 40;
    private final int SPEED = 2;

    private Image image;

    public Penguin(int x, int y, String imagePath) {
        this.x = x;
        this.y = y;

        ImageIcon icon = new ImageIcon(imagePath);
        image = icon.getImage();
    }

    public int getX() {
        return x;
    }

    public int getY() {
        return y;
    }

    public int getSize() {
        return SIZE;
    }

    public int getSpeed() {
        return SPEED;
    }

    public void setPosition(int x, int y) {
        this.x = x;
        this.y = y;
    }

    public void draw(Graphics g) {
        g.drawImage(
                image,
                x,
                y,
                SIZE,
                SIZE,
                null
        );
    }
    public int getCenterX() {
        return x + SIZE / 2;
    }
    
    public int getCenterY() {
        return y + SIZE / 2;
    }
    public boolean updateTilePosition(int boardX, int boardY, int tileSize) {
    
        int centerX = x + SIZE / 2;
        int centerY = y + SIZE / 2;
    
        int newCol = (centerX - boardX) / tileSize;
        int newRow = (centerY - boardY) / tileSize;
    
        if (newRow != currentRow || newCol != currentCol) {
    
            currentRow = newRow;
            currentCol = newCol;
    
            return true;
        }
    
        return false;
    }
    public int getCurrentRow() {
        return currentRow;
    }
    
    public int getCurrentCol() {
        return currentCol;
    }
    public void resetTilePosition() {
        currentRow = -1;
        currentCol = -1;
    }
}
