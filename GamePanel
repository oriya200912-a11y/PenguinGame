import javax.swing.*;
import java.awt.*;

public class GamePanel extends JPanel {

    private final int ROWS = 8;
    private final int COLS = 10;
    private final int TILE_SIZE = 60;
    private Penguin player1;
    private Penguin player2;

    public GamePanel() {

        setBackground(Color.CYAN);
    
        player1 = new Penguin(0, 0, Color.RED);
        player2 = new Penguin(7, 9, Color.GREEN);
    
        setFocusable(true);
    
        addKeyListener(new java.awt.event.KeyAdapter() {
    
            @Override
            public void keyPressed(java.awt.event.KeyEvent e) {
    
                if (e.getKeyCode() == java.awt.event.KeyEvent.VK_W) {
                    player1.moveUp();
                }
    
                if (e.getKeyCode() == java.awt.event.KeyEvent.VK_S) {
                    player1.moveDown(ROWS);
                }
    
                if (e.getKeyCode() == java.awt.event.KeyEvent.VK_A) {
                    player1.moveLeft();
                }
    
                if (e.getKeyCode() == java.awt.event.KeyEvent.VK_D) {
                    player1.moveRight(COLS);
                }
    
                if (e.getKeyCode() == java.awt.event.KeyEvent.VK_UP) {
                    player2.moveUp();
                }
    
                if (e.getKeyCode() == java.awt.event.KeyEvent.VK_DOWN) {
                    player2.moveDown(ROWS);
                }
    
                if (e.getKeyCode() == java.awt.event.KeyEvent.VK_LEFT) {
                    player2.moveLeft();
                }
    
                if (e.getKeyCode() == java.awt.event.KeyEvent.VK_RIGHT) {
                    player2.moveRight(COLS);
                }
    
                repaint();
            }
        });
    
        requestFocusInWindow();
    }
}
